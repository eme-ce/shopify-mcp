# ============================================================
#  Servidor MCP de Shopify — Variables de entorno
#  Copiá este archivo a .env y completá tus valores. Nunca subirlo a github!
# ============================================================

# ----------------------------------------------------------
# REQUERIDO: El nombre de tu tienda Shopify
# Es la parte ANTES de .myshopify.com
# Ejemplo: si tu URL es mi-tienda.myshopify.com → poné: mi-tienda
# ----------------------------------------------------------
SHOPIFY_STORE=mi-tienda

# ----------------------------------------------------------
# REQUERIDO: Autenticación
# Elegí UNA de las dos opciones de abajo.
# ----------------------------------------------------------

# OPCIÓN A — Recomendada para la mayoría: Access Token estático
# Cómo conseguirlo:
#   1. Shopify Admin → Configuración → Apps y canales de venta
#   2. Hacé clic en "Desarrollar apps" → Crear una app
#   3. Andá a Configuración → Configurar alcances de la Admin API → seleccioná permisos → Guardar
#   4. Andá a Credenciales de API → Instalar app → Revelar token una vez
#   5. Copiá el token abajo (empieza con shpat_)
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPCIÓN B — Avanzada: OAuth Client Credentials (habilita auto-renovación del token)
# Usá esto solo si tenés una app de Shopify con OAuth configurado.
# Dejá ambas en blanco si estás usando la Opción A.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ----------------------------------------------------------
# OPCIONAL: Versión de la API de Shopify
# El valor por defecto es 2025-01. Cambialo solo si necesitás una versión específica.
# ----------------------------------------------------------
SHOPIFY_API_VERSION=2025-01

# ----------------------------------------------------------
# OPCIONAL: Ajustes de seguridad
# BEARER_TOKEN            — Token que deben enviar los clientes (Authorization: Bearer <token>)
# ALLOW_TOKEN_QUERY_PARAM — Poner en 1 solo si tu cliente MCP no puede enviar headers
# MAX_REQUEST_BODY        — Tamaño máximo del cuerpo entrante en bytes (por defecto: 1048576 = 1 MB)
# RATE_LIMIT_RPM          — Máximo de requests por minuto por IP (por defecto: 60)
# RATE_LIMIT_MAX_IPS      — Máximo de IPs rastreadas por el limitador de tasa (por defecto: 10000)
# TRUSTED_PROXY_COUNT     — Cuántos proxies inversos hay delante del servidor (por defecto: 1)
# ----------------------------------------------------------
BEARER_TOKEN=
ALLOW_TOKEN_QUERY_PARAM=
MAX_REQUEST_BODY=1048576
RATE_LIMIT_RPM=60
RATE_LIMIT_MAX_IPS=10000
TRUSTED_PROXY_COUNT=1

# ----------------------------------------------------------
# OPCIONAL: Configuración del servidor
# PORT          — El puerto en el que corre el servidor MCP (por defecto: 8000)
# MCP_TRANSPORT — Dejalo como streamable-http para usar con Claude.ai
# ----------------------------------------------------------
PORT=8000
MCP_TRANSPORT=streamable-http
